{
  "name": "visor",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node esbuild.config.mjs",
    "harness": "vite --host 127.0.0.1",
    "test:ui": "playwright test",
    "start": "npm run build && electron build/app",
    "package": "npm run build && node scripts/package.mjs",
    "test:electron": "node scripts/test-electron.mjs && node scripts/test-electron-markdown.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:wiki:production": "node scripts/test-wiki-exports.mjs",
    "test:wiki:development": "node --conditions=development scripts/test-wiki-exports.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "1.1.5",
    "@lxcid/remark-wikilink": "0.2.0",
    "@xyflow/react": "13.0.2",
    "hast-util-to-jsx-runtime": "2.3.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.56.1",
    "@types/dagre": "0.7.53",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.4.1",
    "esbuild": "0.27.0",
    "jsdom": "27.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  },
  "description": "Read-only local Wayfinder folder maps"
}
